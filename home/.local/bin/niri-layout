#!/usr/bin/python3 -S
import os, socket, sys

CMD_SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "niri-layout.sock")

if __name__ == "__main__" and sys.argv[1:2] in (["full"], ["edges"]):
    # a key press spawns this: handed to the daemon before anything else is loaded
    try:
        s = socket.socket(socket.AF_UNIX)
        s.connect(CMD_SOCK)
        s.sendall(sys.argv[1].encode() + b"\n")
        s.close()
        sys.exit(0)
    except OSError:
        pass

import glob, json, queue, re, threading, time

PEEK = int(os.environ.get("NIRI_LAYOUT_PEEK", "50"))
TOL = 1.5
_SOCK = None
_CONN = None

def sock_path():
    global _SOCK
    if _SOCK and os.path.exists(_SOCK):
        return _SOCK
    p = os.environ.get("NIRI_SOCKET")
    if not (p and os.path.exists(p)):
        found = sorted(glob.glob("/run/user/%d/niri.*.sock" % os.getuid()), key=os.path.getmtime)
        if not found:
            sys.exit("niri-layout: no niri socket")
        p = found[-1]
    _SOCK = p
    return p

def request(*reqs):
    """One connection kept open: niri answers the requests of a connection in order, each once
    it has been carried out."""
    global _CONN
    data = b"".join(json.dumps(r).encode() + b"\n" for r in reqs)
    for retry in (False, True):
        try:
            if _CONN is None:
                s = socket.socket(socket.AF_UNIX)
                s.connect(sock_path())
                _CONN = (s, s.makefile("r"))
            _CONN[0].sendall(data)
            return [json.loads(_CONN[1].readline()) for _ in reqs]
        except (OSError, ValueError):
            if _CONN:
                _CONN[0].close()
            _CONN = None
            if retry:
                raise

# Tile widths as niri reports them in its event stream, kept by the daemon's reader thread: a
# width change is seen the moment niri lays it out, not at the next poll.
LIVE = {}
LIVE_CV = threading.Condition()
LIVE_ON = False

def live_update(ev):
    if "WindowLayoutsChanged" in ev:
        ch = [(i, l["tile_size"][0]) for i, l in ev["WindowLayoutsChanged"]["changes"]]
    elif "WindowOpenedOrChanged" in ev:
        w = ev["WindowOpenedOrChanged"]["window"]
        ch = [(w["id"], w["layout"]["tile_size"][0])]
    elif "WindowsChanged" in ev:
        ch = [(w["id"], w["layout"]["tile_size"][0]) for w in ev["WindowsChanged"]["windows"]]
    else:
        return
    with LIVE_CV:
        LIVE.update(ch)
        LIVE_CV.notify_all()

def action(name, **args):
    return {"Action": {name: args}}

def gaps():
    g = 16
    d = os.path.expanduser("~/.config/niri")
    try:
        text = open(os.path.join(d, "config.kdl")).read()
        for m in re.finditer(r'^\s*(?:gaps\s+(\d+)|include\s+(?:optional=true\s+)?"([^"]+)")', text, re.M):
            if m.group(1):
                g = int(m.group(1))
            else:
                try:
                    for n in re.findall(r"^\s*gaps\s+(\d+)", open(os.path.join(d, m.group(2))).read(), re.M):
                        g = int(n)
                except OSError:
                    pass
    except OSError:
        pass
    return g

G = gaps()

class State:
    def __init__(self):
        wins, wss, outs = request("Windows", "Workspaces", "Outputs")
        self.windows = wins["Ok"]["Windows"]
        self.workspaces = {w["id"]: w for w in wss["Ok"]["Workspaces"]}
        self.outputs = outs["Ok"]["Outputs"]
        self.focused = next((w for w in self.windows if w["is_focused"]), None)
        self.focused_ws = next((w["id"] for w in self.workspaces.values() if w["is_focused"]), None)

    def size(self, ws_id):
        o = self.outputs.get(self.workspaces.get(ws_id, {}).get("output") or "", {}).get("logical")
        return (o["width"], o["height"]) if o else None

    def columns(self, ws_id):
        cols = {}
        for w in self.windows:
            pos = w["layout"]["pos_in_scrolling_layout"]
            if w["workspace_id"] == ws_id and not w["is_floating"] and pos:
                cols.setdefault(pos[0], []).append(w)
        return [sorted(cols[k], key=lambda w: w["layout"]["pos_in_scrolling_layout"][1]) for k in sorted(cols)]

    def signature(self, ws_id):
        return (self.workspaces[ws_id].get("output"), tuple(tuple(w["id"] for w in c) for c in self.columns(ws_id)))

def widths(W):
    return {"half_fit": (W - 3 * G) // 2, "half_ovf": (W - PEEK - 3 * G) // 2,
            "half_mid": (W - 2 * PEEK - 3 * G) // 2,
            "full": [W - 2 * G - n * PEEK for n in range(3)]}

def classify(win, W, H):
    tw, th = win["layout"]["tile_size"]
    if tw >= W - 0.5:
        return "edges"
    k = widths(W)
    if any(abs(tw - x) < TOL for x in (k["half_fit"], k["half_ovf"], k["half_mid"])):
        return "half"
    if any(abs(tw - x) < TOL for x in k["full"]):
        return "full"
    return "other"

def plan_widths(st, ws_id, cls_override=None):
    """Target width of every column of one workspace: [(head window, current width, target)],
    target None for a column left alone (edge to edge). cls_override maps a window id to a class
    (or to a pixel width for "other"). Also returns whether the strip fits on the screen."""
    size = st.size(ws_id)
    cols = st.columns(ws_id)
    if not size or not cols:
        return [], True
    W, H = size
    k = widths(W)
    over = cls_override or {}
    plan = []
    for c in cols:
        head = c[0]
        cls = classify(head, W, H)
        px = head["layout"]["tile_size"][0]
        for w in c:
            if w["id"] in over:
                cls = over[w["id"]]
                if isinstance(cls, (int, float)):
                    cls, px = "other", cls
        plan.append([head, cls, px])
    nominal = {"half": k["half_fit"], "full": k["full"][0], "edges": k["full"][0]}
    fits = sum(nominal.get(cls, px) for _, cls, px in plan) + (len(plan) + 1) * G <= W + TOL
    n = len(plan)
    mid = lambda j: 0 < j < n - 1 and plan[j][1] == "half"
    is_mid = [not fits and mid(i) and (mid(i - 1) or mid(i + 1)) for i in range(n)]
    out = []
    for i, (head, cls, px) in enumerate(plan):
        if cls == "edges":
            target = None
        elif cls == "half":
            if fits or (i == 0 and n > 1 and is_mid[1]) or (i == n - 1 and n > 1 and is_mid[n - 2]):
                target = k["half_fit"]
            elif is_mid[i]:
                target = k["half_mid"]
            else:
                target = k["half_ovf"]
        elif cls == "full":
            target = k["full"][(i > 0) + (i < n - 1)]
        else:
            target = px
        out.append((head, head["layout"]["tile_size"][0], target if target is None else int(target)))
    return out, fits


def set_widths(targets):
    """targets {window id: width}: send them, wait until the windows have them."""
    if targets:
        request(*[action("SetWindowWidth", id=i, change={"SetFixed": t}) for i, t in targets.items()])
        wait_sizes(targets)


def relayout(st, ws_id, cls_override=None):
    """Set the column widths of one workspace (see plan_widths). Returns True when a width was
    changed."""
    plan, _ = plan_widths(st, ws_id, cls_override)
    want = {}
    for head, cur, target in plan:
        if target is not None and abs(cur - target) >= TOL:
            if target < cur and cur < st.size(ws_id)[0] - 0.5:     # not leaving edge to edge
                LAST_SHRINK[head["id"]] = time.monotonic()
            want[head["id"]] = target
    set_widths(want)
    return bool(want)

def wait_sizes(want, timeout=1.0):
    """niri lays the columns out with the sizes the windows actually have, and a window takes a
    frame or two to answer a resize; the view is only fixed up once they did. Whatever is sent
    next has to follow the commit closely: niri starts the resize animation at the commit, and a
    scroll sent d ms later trails it by about 2 * d / duration of the width change."""
    ok = lambda sizes: all(abs(sizes.get(i, t) - t) < TOL for i, t in want.items())
    end = time.monotonic() + timeout
    if LIVE_ON:
        with LIVE_CV:
            while not ok(LIVE):
                left = end - time.monotonic()
                if left <= 0:
                    return
                LIVE_CV.wait(left)
        return
    while time.monotonic() < end:
        if ok({w["id"]: w["layout"]["tile_size"][0] for w in request("Windows")[0]["Ok"]["Windows"]}):
            return
        time.sleep(0.001)

LAST_SHRINK = {}

# The view. niri does not report where it has scrolled to and has no "scroll to" action: it
# scrolls only to a focused column that is not fully visible (flush with the screen edge it comes
# in from, a gap away), centers one on request (center-column), and when a width changes keeps the
# focused column where it is on screen. Those rules are few, so the daemon follows the view itself:
# VIEW[ws] = {"ids": columns, "w": widths, "a": focused column, "V": where the screen starts, in
# strip coordinates (columns side by side from 0, a gap between)}. Not there when unknown (at the
# start, after a change not followed, like a column moved); then place_blind's hops are used.
VIEW = {}


def colx(w):
    xs, x = [], 0.0
    for v in w:
        xs.append(x)
        x += v + G
    return xs


def sim(ops, w, V, a, W):
    """niri's rules over ops: ("f", k) focus column k, ("w", k, px) width of column k, ("c",)
    center the focused column. Returns (V, focused column, widths, V after every op)."""
    w = list(w)
    path = []

    def ensure(V, k):
        x = colx(w)[k] - V
        if x < -TOL:
            return colx(w)[k] - G
        if x + w[k] > W + TOL:
            return colx(w)[k] + w[k] + G - W
        return V

    for op in ops:
        if op[0] == "f":
            a = op[1]
            V2 = ensure(V, a)
        elif op[0] == "w":
            before = colx(w)[a]
            w[op[1]] = op[2]
            V = V + colx(w)[a] - before     # strip coordinates moved, nothing on screen
            V2 = ensure(V, a)
        elif op[0] == "c":
            V2 = colx(w)[a] + w[a] / 2 - W / 2
        elif op[0] == "cv":
            xs = colx(w)
            vis = [k for k in range(len(w)) if xs[k] - V >= -TOL and xs[k] + w[k] - V <= W + TOL]
            V2 = (xs[vis[0]] + xs[vis[-1]] + w[vis[-1]] - W) / 2 if vis else xs[a] + w[a] / 2 - W / 2
        else:
            continue
        path.append(V2 - V if op[0] != "w" else (V2 - V) * JUMP)   # how far the view scrolls
        V = V2
    return V, a, w, path


JUMP = 1.0000001    # marks a scroll that comes with a width change: niri does not animate it


def reversals(ops, w, V, a, W):
    """How often an edge of a window on screen moves one way and later the other way."""
    w = list(w)
    clip = lambda v: min(max(v, 0), W)
    def edges(w, V):
        xs = colx(w)
        return [(clip(xs[k] - V), clip(xs[k] + w[k] - V)) for k in range(len(w))]
    seq = [edges(w, V)]
    for op in ops:
        V, a, w, _ = sim([op], w, V, a, W)
        seq.append(edges(w, V))
    n = 0
    for k in range(len(w)):
        for e in (0, 1):
            d = [seq[i + 1][k][e] - seq[i][k][e] for i in range(len(seq) - 1)]
            d = [v for v in d if abs(v) > 3]
            n += sum(1 for p, q in zip(d, d[1:]) if p * q < 0)
    return n


def jumps(path):
    return sum(1 for d in path if abs(d) > TOL and abs(abs(d) / JUMP - abs(d)) > 1e-9 * abs(d))


def monotonic(V0, path):
    steps = [d for d in path if abs(d) > TOL]
    return all(s > 0 for s in steps) or all(s < 0 for s in steps)


def target_x(w, t, W, d=0, cur=None):
    """Where column t has to start on screen: whole, a strip of the neighbour on every side that
    has one, nothing empty on a side without one."""
    n = len(w)
    two1 = W - 2 * G - PEEK
    two2 = W - 2 * G - 2 * PEEK
    if sum(w) + (n + 1) * G <= W + TOL:
        return G + colx(w)[t]
    if t == 0:
        return G
    if t == n - 1:
        return W - G - w[t]
    if w[t] >= two2 - TOL:
        return (W - w[t]) / 2                           # full width: both strips
    pair = lambda a, b: 0 <= a and b < n and abs(w[a] + G + w[b] - (two2 if a > 0 and b < n - 1 else two1)) < TOL
    right, left = pair(t, t + 1), pair(t - 1, t)
    xr, xl = G + PEEK, (G + PEEK if t > 1 else G) + w[t - 1] + G
    if right and left:
        mr, ml = t + 1 < n - 1, t - 1 > 0
        if mr != ml:
            return xr if mr else xl
        if cur is not None and min(abs(cur - xr), abs(cur - xl)) < TOL:
            return cur                                  # already one of the two: no movement
        return xl if d < 0 else xr
    if right:
        return xr
    if left:
        return xl
    return (W - w[t]) / 2


def candidates(w, t):
    """Op sequences that end with column t focused, simplest first."""
    n = len(w)
    out = [[], [("c",)], [("cv",)]]
    out += [[("f", k), ("f", t)] for k in sorted((k for k in range(n) if k != t), key=lambda k: abs(k - t))]
    out += [[("f", k), ("f", t), ("cv",)] for k in (t + 1, t - 1) if 0 <= k < n]
    for k in (t + 1, t - 1):
        if 0 <= k < n:
            out.append([("f", k), ("w", t, w[t] + PEEK), ("f", t), ("f", k), ("w", t, w[t]), ("f", t)])
    if n > 1:
        out.append([("f", n - 1), ("c",), ("f", 0), ("f", t)])
        out.append([("f", 0), ("c",), ("f", n - 1), ("f", t)])
    return out


def choose(w, V, a, t, W, xt):
    """The first candidate that ends exactly at xt for column t moving the view one way only;
    else the first that ends there at all; (None, None) when none does."""
    exact = None
    for c in candidates(w, t):
        Vf, af, wf, path = sim(c, w, V, a, W)
        if af != t or abs(colx(wf)[t] - Vf - xt) > TOL:
            continue
        if monotonic(V, path):
            return c, Vf
        exact = exact or (c, Vf)
    return exact or (None, None)


def execute(ops, cols, f, t, history=()):
    """Send ops: focus and center ops in one write, a width change waited for, and, right after a
    slide, sent only once it is over (changed during one, a column's edge shows moving inside the
    screen). Focus ends on f (or t)."""
    pending = []
    slid = 0.0
    w = [c[0]["layout"]["tile_size"][0] for c in cols]

    def pick(k):
        ids = [x["id"] for x in cols[k]]
        if t["id"] in ids:
            return t["id"]
        return next((x for x in reversed(history) if x in ids), ids[0])

    def flush():
        nonlocal slid
        if pending:
            request(*pending)
            slid = time.monotonic()
            pending.clear()

    widths_now = {}

    def flush_widths():
        if widths_now:
            left = slid + anim_secs("horizontal-view-movement") + 0.02 - time.monotonic()
            if left > 0:
                time.sleep(left)    # changed during a slide, an edge shows moving the other way
            set_widths({cols[k][0]["id"]: int(v) for k, v in widths_now.items()})
            for k, v in widths_now.items():
                w[k] = v
            widths_now.clear()

    for op in ops:
        if op[0] == "w":
            flush()
            widths_now[op[1]] = op[2]       # widths next to each other go out together
            continue
        flush_widths()
        if op[0] == "f":
            pending.append(action("FocusWindow", id=pick(op[1])))
        elif op[0] == "c":
            pending.append(action("CenterColumn"))
        elif op[0] == "cv":
            pending.append(action("CenterVisibleColumns"))
    flush_widths()
    want = f["id"] if f else t["id"]
    if f and f is not t:
        pending.append(action("FocusWindow", id=want))
    flush()
    if any(op[0] == "f" for op in ops) or (f and f is not t):
        # niri replies to an action once it is done: checked right away, no sleep (a FocusWindow
        # resent 30 ms late restarts the view on its way)
        now = request("FocusedWindow")[0]["Ok"]["FocusedWindow"]
        if not now or now["id"] != want:
            request(action("FocusWindow", id=want))


def known_view(st, ws_id):
    m = VIEW.get(ws_id)
    cols = st.columns(ws_id)
    w = [c[0]["layout"]["tile_size"][0] for c in cols]
    if (not m or m["ids"] != st.signature(ws_id)[1] or len(m["w"]) != len(w)
            or any(abs(a - b) > TOL for a, b in zip(m["w"], w))):
        return None
    return m["V"]


def place(ws_id, history=(), settle=False, d=0, removed=False):
    """Put the view so the focused column shows whole, with a strip of its neighbour on every side
    that has one and no empty space on a side without one (target_x), in one movement (choose)."""
    st = State()
    if st.focused_ws != ws_id:
        return False
    f = st.focused
    cols = st.columns(ws_id)
    tiled = {w["id"]: w for c in cols for w in c}
    t = f if f and f["id"] in tiled else next((tiled[i] for i in reversed(history) if i in tiled), None)
    size = st.size(ws_id)
    if not t or not size or classify(t, *size) == "edges":
        VIEW.pop(ws_id, None)
        return False
    W, H = size
    ti = t["layout"]["pos_in_scrolling_layout"][0] - 1
    w = [c[0]["layout"]["tile_size"][0] for c in cols]
    n = len(cols)
    V = known_view(st, ws_id)
    if V is None:
        return place_blind(st, ws_id, cols, f, t, history, settle, d, removed)
    xt = target_x(w, ti, W, d, colx(w)[ti] - V)
    ops, Vf = choose(w, V, ti, ti, W, xt)
    dbg("place t", t["id"], "V", V, "xt", xt, "ops", ops)
    if ops is None and n == 1 and len(cols[0]) == 1:
        # a lone column away from the left edge, fully visible: no scroll moves it. Out to
        # floating and back in: niri puts it at the left edge (drawn once 4 px off, same size)
        request(action("ToggleWindowFloating", id=t["id"]), action("ToggleWindowFloating", id=t["id"]))
        VIEW[ws_id] = {"ids": st.signature(ws_id)[1], "w": w, "a": 0, "V": -G}
        return True
    if ops is None:
        return place_blind(st, ws_id, cols, f, t, history, settle, d, removed)
    if ops or (f and f is not t):
        now = request("FocusedWindow")[0]["Ok"]["FocusedWindow"]
        if (now and now["id"]) != (f and f["id"]):
            return False            # the user moved on meanwhile: the next event does it
        execute(ops, cols, f, t, history)
    _, _, wf, _ = sim(ops, w, V, ti, W)
    VIEW[ws_id] = {"ids": st.signature(ws_id)[1], "w": wf, "a": ti, "V": Vf}
    return True


def place_blind(st, ws_id, cols, f, t, history, settle, d, removed):
    """Without a known view: hops that are right in the usual cases; the view is taken as placed
    afterwards."""
    W, H = st.size(ws_id)
    i = t["layout"]["pos_in_scrolling_layout"][0] - 1
    w = [c[0]["layout"]["tile_size"][0] for c in cols]
    n = len(cols)

    def pick(c):
        ids = [x["id"] for x in c]
        return next((x for x in reversed(history) if x in ids), ids[0])

    two = W - 2 * G - PEEK
    go = lambda wid: action("FocusWindow", id=wid)
    fits = sum(w) + (n + 1) * G <= W + TOL
    hops = []
    if fits:
        first = pick(cols[0])
        hops = [go(first)]
        if settle and n > 1 and W / 2 - w[-1] / 2 - (sum(w[:-1]) + (n - 1) * G) < 0:
            hops = [action("FocusColumnLast"), action("CenterColumn"), go(first)]
        elif settle and n == 1 and len(cols[0]) == 1:
            hops += [action("ToggleWindowFloating", id=first), action("ToggleWindowFloating", id=first)]
    elif i == n - 1 and n > 1 and (removed or time.monotonic() - LAST_SHRINK.get(cols[i][0]["id"], -9) < 2):
        hops = [action("FocusColumnFirst")]
    elif i == 0 and n > 1 and removed:
        hops = [action("FocusColumnLast")]
    elif 0 < i < n - 1:
        xt = target_x(w, i, W, d)
        if abs(xt - (W - w[i]) / 2) < TOL:
            hops = [action("CenterColumn")]
        elif abs(xt - (G + PEEK)) < TOL:
            hops = [go(pick(cols[i + 1]))] + ([go(t["id"]), action("CenterVisibleColumns")] if i + 1 < n - 1 else [])
        elif abs(xt - (G + w[i - 1] + G)) < TOL:
            hops = [go(pick(cols[i - 1]))]
        elif abs(xt - (G + PEEK + w[i - 1] + G)) < TOL:
            hops = [go(pick(cols[i - 1])), go(t["id"]), action("CenterVisibleColumns")]
        else:
            hops = [action("CenterColumn")]
    dbg("blind t", t["id"], "i", i, "n", n, "w", w, "hops", hops)
    if hops:
        reqs = [action("FocusTiling")] + hops
        if hops[-1] not in (action("CenterColumn"), action("CenterVisibleColumns")):
            reqs.append(go(t["id"]))
        if f and f is not t and f["workspace_id"] == ws_id:
            reqs.append(go(f["id"]))
        now = request("FocusedWindow")[0]["Ok"]["FocusedWindow"]
        if (now and now["id"]) != (f and f["id"]):
            return False
        request(*reqs)
        want = f["id"] if f and f is not t else t["id"]
        now = request("FocusedWindow")[0]["Ok"]["FocusedWindow"]
        if not now or now["id"] != want:
            request(go(want))
    # from here on the view is taken to be where it was meant to go
    st2 = State()
    cols2 = st2.columns(ws_id)
    w2 = [c[0]["layout"]["tile_size"][0] for c in cols2]
    i2 = next((k for k, c in enumerate(cols2) if t["id"] in [x["id"] for x in c]), None)
    if i2 is None or (fits and settle and n > 1 and len(hops) == 1):
        VIEW.pop(ws_id, None)       # narrow columns that fit may have stayed away from the edge
    else:
        VIEW[ws_id] = {"ids": st2.signature(ws_id)[1], "w": w2, "a": i2,
                       "V": colx(w2)[i2] - target_x(w2, i2, W, d)}
    return True


_ANIM = {}

def anim_secs(name):
    """Length of one of niri's animations from config.kdl (slowdown applied), 0 when off."""
    try:
        key = (name, os.path.getmtime(os.path.expanduser("~/.config/niri/config.kdl")))
    except OSError:
        key = (name, None)
    if key not in _ANIM:
        _ANIM[key] = _anim_secs(name)
    return _ANIM[key]

def _anim_secs(name):
    try:
        text = open(os.path.expanduser("~/.config/niri/config.kdl")).read()
        block = re.search(r"^animations \{\n(.*?)^\}", text, re.M | re.S).group(1)
    except (OSError, AttributeError):
        return 0.15
    slow = float((re.search(r"^\s*slowdown\s+([0-9.]+)", block, re.M) or [0, 1])[1])
    m = re.search(r"^\s*%s\s*\{(.*?)\}" % re.escape(name), block, re.M | re.S)
    if not m or re.search(r"\boff\b", m.group(1)):
        return 0.0
    d = re.search(r"duration-ms\s+(\d+)", m.group(1))
    return (int(d.group(1)) / 1000 if d else 0.3) * slow


KEY_MARK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "niri-layout.key")


def key(which):
    """Mod+F / Mod+Shift+F: done by the daemon, which knows the view; alone if it does not run."""
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(5)
        s.connect(CMD_SOCK)
        s.sendall(which.encode() + b"\n")
        s.recv(16)
        s.close()
    except OSError:
        key_run(which)


def dbg(*a):
    if os.environ.get("NIRI_LAYOUT_DEBUG"):
        print(*a, file=sys.stderr, flush=True)


def key_run(which, history=()):
    st = State()
    f = st.focused
    fallback = "MaximizeColumn" if which == "full" else "MaximizeWindowToEdges"
    size = f and st.size(f["workspace_id"])
    if not f or f["is_floating"] or not f["layout"]["pos_in_scrolling_layout"] or not size:
        request(action(fallback) if which == "full" else action(fallback, id=None))
        return
    W, H = size
    ws = f["workspace_id"]
    cls = classify(f, W, H)
    if cls == "edges" and f["layout"]["tile_size"][1] >= H - 0.5:
        request(action(fallback) if which == "full" else action(fallback, id=None))
        return
    open(KEY_MARK, "w").close()     # these widths are not a change by hand
    if which == "edges" and cls != "edges":
        request(action("MaximizeWindowToEdges", id=f["id"]))
        return
    new = "half" if (which == "full" and cls == "full") else "full"
    if cls == "edges":
        # leaving edge to edge: niri unmaximizes and slides the view back where it was before;
        # placed after that slide, or niri's slide undoes it
        relayout(st, ws, {f["id"]: new})
        time.sleep(anim_secs("horizontal-view-movement") + 0.05)
        VIEW.pop(ws, None)
        place(ws, history)
        return
    cols = st.columns(ws)
    w = [c[0]["layout"]["tile_size"][0] for c in cols]
    t = f["layout"]["pos_in_scrolling_layout"][0] - 1
    V = known_view(st, ws) if cls != "edges" else None
    dbg("key", which, "t", f["id"], "V", V, "view", VIEW.get(ws), "sig", st.signature(ws)[1])
    plan, fits = plan_widths(st, ws, {f["id"]: new})
    for p in plan:
        if p[2] is not None and p[2] < p[1] - TOL and p[1] < W - 0.5:
            LAST_SHRINK[p[0]["id"]] = time.monotonic()
    nw = [p[2] if p[2] is not None else w[k] for k, p in enumerate(plan)]
    xt = target_x(nw, t, W)
    if V is None and new == "half":
        relayout(st, ws, {f["id"]: new})
        place(ws, history)
        return
    if V is None:
        V = colx(w)[t] - target_x(w, t, W)
    phases, ops = toggle_plan(w, t, nw, V, W, xt)
    dbg("key phases", phases)
    run_phases(phases, cols, f, history)
    Vf, af, wf, _ = sim(ops, w, V, t, W)
    VIEW[ws] = {"ids": st.signature(ws)[1], "w": wf, "a": t, "V": Vf}


def screen_edges(w, V, W):
    xs = colx(w)
    return [(min(max(xs[k] - V, 0), W), min(max(xs[k] + w[k] - V, 0), W)) for k in range(len(w))]


def unseen(op, w, V, a, W):
    """A width change that moves nothing on screen: the column is off screen, or it is a peek
    strip whose on-screen side stays (niri holds the focused column, so a column on its left
    keeps its right edge and one on its right its left edge)."""
    V2, _, w2, _ = sim([op], w, V, a, W)
    return all(abs(p - q) < 1 for e1, e2 in zip(screen_edges(w, V, W), screen_edges(w2, V2, W))
               for p, q in zip(e1, e2))


def toggle_plan(w, t, nw, V, W, xt):
    """Mod+F as phases: ("send", ops) one write, ("wait", columns) until they took their width.

    niri moves the view along with a width change only when the focused column outgrows the
    screen; a focused column that narrows keeps its left edge, so on its own its right edge
    comes in and shows the background. So: the neighbours that change unseen first; then t,
    either while another column is focused that already puts the view where it ends (the last
    column: its right edge is off screen while it narrows, and focusing it back does not
    scroll), or alone with the scroll sent the moment it took the width; the neighbours that
    would show last (t focused: they do not move it)."""
    n = len(w)
    wt = ("w", t, nw[t])
    others = [("w", k, nw[k]) for k in range(n) if k != t and abs(nw[k] - w[k]) >= TOL]
    first = [o for o in others if unseen(o, w, V, t, W)]
    later = [o for o in others if o not in first]
    Va, _, wa, _ = sim(first, w, V, t, W)
    wb = list(wa)
    wb[t] = nw[t]
    Vb = sim([wt], wa, Va, t, W)[0]
    cands = [([wt], [], later)]
    if nw[t] < w[t] and t == n - 1 and n > 1:
        cands += [([("f", k), wt], [("f", t)], later) for k in range(t - 1, -1, -1)]
    post, _ = choose(wb, Vb, t, t, W, xt)
    if post:
        cands.append(([wt], post, later))
    if later:
        Vc, _, wc, _ = sim([wt] + later, wa, Va, t, W)
        post, _ = choose(wc, Vc, t, t, W, xt)
        if post is not None:
            cands.append(([wt] + later, post, []))
    best = None
    for pre, post, rest in cands:
        ops = first + pre + post + rest
        Vf, af, wf, path = sim(ops, w, V, t, W)
        if af != t or abs(colx(wf)[t] - Vf - xt) >= TOL or any(abs(a - b) >= TOL for a, b in zip(wf, nw)):
            continue
        if pre[0][0] == "f" and abs(sim(first + pre + post, w, V, t, W)[3][-1]) >= TOL:
            continue        # focusing t back scrolls: the view went past where it ends
        r = reversals(ops, w, V, t, W)
        if best is None or r < best[0]:
            best = (r, pre, post, rest)
        if r == 0:
            break
    if best is None:
        best = (0, [wt] + later, choose(wc if later else wb, Vc if later else Vb, t, t, W, xt)[0] or [], [])
    _, pre, post, rest = best
    phases = []
    if first:
        phases += [("send", first), ("wait", [o[1] for o in first])]
    phases += [("send", pre), ("wait", [o[1] for o in pre if o[0] == "w"])]
    if post:
        phases.append(("send", post))
    if rest:
        phases.append(("send", rest))
    return phases, first + pre + post + rest


PENDING = {}            # widths sent last and not waited for: the next key waits for them
BUSY = [0.0]            # until when the animations of the last key run


def run_phases(phases, cols, f, history=()):
    def pick(k):
        ids = [x["id"] for x in cols[k]]
        if f["id"] in ids:
            return f["id"]
        return next((x for x in reversed(history) if x in ids), ids[0])

    def enc(op):
        if op[0] == "w":
            return action("SetWindowWidth", id=cols[op[1]][0]["id"], change={"SetFixed": int(op[2])})
        if op[0] == "f":
            return action("FocusWindow", id=pick(op[1]))
        return action("CenterColumn" if op[0] == "c" else "CenterVisibleColumns")

    sent = {}
    for kind, arg in phases:
        if kind == "send":
            if arg:
                request(*[enc(o) for o in arg])
                sent.update({cols[o[1]][0]["id"]: int(o[2]) for o in arg if o[0] == "w"})
        else:
            ids = [cols[k][0]["id"] for k in arg]
            wait_sizes({i: sent.pop(i) for i in ids if i in sent})
    PENDING.update(sent)
    now = request("FocusedWindow")[0]["Ok"]["FocusedWindow"]
    if not now or now["id"] != f["id"]:
        request(action("FocusWindow", id=f["id"]))
    BUSY[0] = time.monotonic() + max(anim_secs("window-resize"), anim_secs("horizontal-view-movement"))


def view_follow(st, ws):
    """Carry the known view of a workspace over what niri did by itself since: another column
    focused, widths changed (by hand, or by a window), one column opened or closed. Dropped when
    it is anything else."""
    old = VIEW.get(ws)
    size = st.size(ws)
    if not old or not size:
        VIEW.pop(ws, None)
        return
    W = size[0]
    cols = st.columns(ws)
    ids = st.signature(ws)[1]
    w = [c[0]["layout"]["tile_size"][0] for c in cols]
    if any(v >= W - 0.5 for v in w):
        VIEW.pop(ws, None)          # edge to edge or fullscreen: niri's own view, back after it
        return
    act = st.workspaces[ws].get("active_window_id")
    a = next((k for k, c in enumerate(cols) if act in [x["id"] for x in c]), None)
    if a is None:
        VIEW.pop(ws, None)
        return
    oids, ow, V, oa = list(old["ids"]), list(old["w"]), old["V"], old["a"]
    oset, nset = [frozenset(c) for c in oids], [frozenset(c) for c in ids]
    if oset != nset:
        if [c for c in oset if c in nset] != [c for c in nset if c in oset]:
            VIEW.pop(ws, None)      # moved, consumed, expelled: not followed
            return
        gone = [k for k, c in enumerate(oset) if c not in nset]
        added = [k for k, c in enumerate(nset) if c not in oset]
        if len(gone) + len(added) != 1:
            VIEW.pop(ws, None)
            return
        if gone:
            g = gone[0]
            if g != oa:             # another column closed: the focused one stays on screen
                before = colx(ow)[oa]
                del ow[g]
                oa -= g < oa
                V += colx(ow)[oa] - before
            else:                   # the focused one: the view stays, its neighbour takes its place
                del ow[g]
                oa = min(g, len(ow) - 1)
        else:                       # a new column, put next to the focused one: nothing moves yet
            j = added[0]
            ow.insert(j, w[j])
            oa += j <= oa
    ops = [("w", k, w[k]) for k in range(len(w)) if abs(ow[k] - w[k]) >= TOL] + [("f", a)]
    V, a, _, _ = sim(ops, ow, V, oa, W)
    VIEW[ws] = {"ids": ids, "w": w, "a": a, "V": V}


def own_widths(st, own, skip=()):
    """Remember the class of every window that has a column to itself (a pixel width for "other",
    edge to edge keeps what it had before), and return {window id: column window ids}."""
    col_of = {}
    for ws in st.workspaces:
        size = st.size(ws)
        for c in st.columns(ws):
            ids = frozenset(w["id"] for w in c)
            for w in c:
                col_of[w["id"]] = ids
            if len(c) == 1 and size and c[0]["id"] not in skip:
                cls = classify(c[0], *size)
                if cls != "edges":
                    own[c[0]["id"]] = c[0]["layout"]["tile_size"][0] if cls == "other" else cls
    return col_of

def key_recent():
    try:
        return time.time() - os.path.getmtime(KEY_MARK) < 1.5
    except OSError:
        return False


def patch_dms_media():
    """Patch DMS's extracted runtime QML so Chromium/Brave players control their PipeWire stream
    volume (or sink fallback) instead of Chromium's no-op MPRIS Volume property."""
    import subprocess
    rt = os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % os.getuid())
    for _ in range(15):
        dirs = glob.glob(os.path.join(rt, "dms-shell/*"))
        if dirs:
            break
        time.sleep(1.0)
    changed = False
    for d in glob.glob(os.path.join(rt, "dms-shell/*")):
        if not os.path.isdir(d):
            continue
        p = os.path.join(d, "Services/AudioService.qml")
        if os.path.exists(p):
            s = old = open(p).read()
            t = '    function isOwnStream(node) {\n        return !!node?.isStream && node.name === "quickshell";\n    }'
            h = t + '''\n\n    function isChromiumPlayer(player) {
        if (!player) return false;
        const id = (player.identity || "").toLowerCase(), bus = (player.dbusName || "").toLowerCase();
        return id.includes("chrome") || id.includes("chromium") || id.includes("brave") || bus.includes(".brave.") || bus.includes(".chromium.") || bus.includes(".chrome.");
    }
    function playerStreams(player) {
        if (!player) return [];
        const id = (player.identity || "").toLowerCase();
        const bus = (player.dbusName || "").toLowerCase().replace(/^org\\.mpris\\.mediaplayer2\\./, "").split(".")[0];
        const token = bus || id.split(/\\s+/)[0];
        if (!token) return [];
        return (root.pipewireNodes || []).filter(node => {
            if (!node?.audio || !node.isSink || !node.isStream || root.isOwnStream(node)) return false;
            const name = (node.name || "").toLowerCase(), app = (node.properties?.["application.name"] || "").toLowerCase(), bin = (node.properties?.["application.process.binary"] || "").toLowerCase();
            return name.includes(token) || app.includes(token) || bin.includes(token) || (name.length > 0 && id.includes(name.split(/\\s+/)[0]));
        });
    }'''
            if "function playerStreams(" not in s and t in s:
                s = s.replace(t, h, 1)
            if s != old:
                os.chmod(os.path.dirname(p), 0o755); os.chmod(p, 0o644); open(p, "w").write(s); changed = True
        p = os.path.join(d, "Modules/DDash/MediaPlayerTab.qml")
        if os.path.exists(p):
            s = old = open(p).read()
            ob = '''    readonly property bool __isChromeBrowser: {
        if (!activePlayer?.identity)
            return false;
        const id = activePlayer.identity.toLowerCase();
        return id.includes("chrome") || id.includes("chromium");
    }
    readonly property bool volumeAvailable: !!((activePlayer && activePlayer.volumeSupported && !__isChromeBrowser) || (AudioService.sink && AudioService.sink.audio))
    readonly property bool usePlayerVolume: activePlayer && activePlayer.volumeSupported && !__isChromeBrowser
    readonly property real reportedVolume: usePlayerVolume ? activePlayer.volume : (AudioService.sink?.audio?.volume ?? 0)'''
            nb = '''    readonly property bool __isChromeBrowser: AudioService.isChromiumPlayer(activePlayer)
    readonly property var playerStreams: __isChromeBrowser ? AudioService.playerStreams(activePlayer) : []
    readonly property var playerStreamAudio: playerStreams.length > 0 ? playerStreams[0].audio : null
    readonly property bool volumeAvailable: !!((activePlayer && activePlayer.volumeSupported && !__isChromeBrowser) || playerStreamAudio || (AudioService.sink && AudioService.sink.audio))
    readonly property bool usePlayerVolume: !!(activePlayer && ((activePlayer.volumeSupported && !__isChromeBrowser) || playerStreamAudio))
    readonly property real reportedVolume: playerStreamAudio ? (playerStreamAudio.muted ? 0 : playerStreamAudio.volume) : (usePlayerVolume ? activePlayer.volume : (AudioService.sink?.audio?.volume ?? 0))'''
            oset = '''        if (usePlayerVolume) {
            pendingVolume = clamped;
            pendingVolumeTimer.restart();
            activePlayer.volume = clamped;
            return;
        }'''
            nset = '''        if (playerStreamAudio) {
            pendingVolume = clamped;
            pendingVolumeTimer.restart();
            for (let i = 0; i < playerStreams.length; i++) {
                const a = playerStreams[i]?.audio;
                if (a) { a.volume = clamped; a.muted = clamped === 0; }
            }
            return;
        }
''' + oset
            if "playerStreamAudio" not in s and ob in s:
                s = s.replace(ob, nb, 1).replace(oset, nset, 1)
            if s != old:
                os.chmod(os.path.dirname(p), 0o755); os.chmod(p, 0o644); open(p, "w").write(s); changed = True
        p = os.path.join(d, "Modules/DBar/Widgets/Media.qml")
        if os.path.exists(p):
            s = old = open(p).read()
            om = '''    readonly property bool __isChromeBrowser: {
        if (!activePlayer?.identity)
            return false;
        const id = activePlayer.identity.toLowerCase();
        return id.includes("chrome") || id.includes("chromium");
    }
    readonly property bool usePlayerVolume: activePlayer && activePlayer.volumeSupported && !__isChromeBrowser'''
            nm = '''    readonly property bool __isChromeBrowser: AudioService.isChromiumPlayer(activePlayer)
    readonly property var playerStreams: __isChromeBrowser ? AudioService.playerStreams(activePlayer) : []
    readonly property var playerStreamAudio: playerStreams.length > 0 ? playerStreams[0].audio : null
    readonly property bool usePlayerVolume: !!(activePlayer && ((activePlayer.volumeSupported && !__isChromeBrowser) || playerStreamAudio))'''
            if "playerStreamAudio" not in s and om in s:
                s = s.replace(om, nm, 1).replace(
                    "const currentVolume = activePlayer.volume * 100;",
                    "const currentVolume = (playerStreamAudio ? (playerStreamAudio.muted ? 0 : playerStreamAudio.volume) : activePlayer.volume) * 100;", 1
                ).replace(
                    "activePlayer.volume = newVolume / 100;",
                    "if (playerStreamAudio) { for (let i = 0; i < playerStreams.length; i++) { playerStreams[i].audio.volume = newVolume / 100; playerStreams[i].audio.muted = newVolume === 0; } } else { activePlayer.volume = newVolume / 100; }", 1
                )
            if s != old:
                os.chmod(os.path.dirname(p), 0o755); os.chmod(p, 0o644); open(p, "w").write(s); changed = True
    if changed:
        subprocess.run(["systemctl", "--user", "reload", "dms.service"], check=False)


QUICK_EVENTS = ("WindowFocusChanged", "WorkspaceActiveWindowChanged", "WindowFocusTimestampChanged",
                "WindowLayoutsChanged", "WindowUrgencyChanged")


def daemon():
    threading.Thread(target=patch_dms_media, daemon=True).start()
    q = queue.Queue()

    def reader():
        global LIVE_ON
        s = socket.socket(socket.AF_UNIX)
        s.connect(sock_path())
        s.sendall(b'"EventStream"\n')
        for line in s.makefile("r"):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict):
                live_update(e)
                LIVE_ON = LIVE_ON or "WindowsChanged" in e
            q.put(e)
        LIVE_ON = False
        q.put(None)

    threading.Thread(target=reader, daemon=True).start()

    def commands():
        try:
            os.unlink(CMD_SOCK)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX)
        srv.bind(CMD_SOCK)
        srv.listen(4)
        while True:
            conn, _ = srv.accept()
            try:
                cmd = conn.makefile("r").readline().strip()
            except OSError:
                conn.close()
                continue
            q.put({"Command": cmd, "conn": conn})

    threading.Thread(target=commands, daemon=True).start()
    held = []   # a key command that came during a burst of events, done right after it

    st = State()
    known = {w["id"] for w in st.windows}
    history = [w["id"] for w in sorted((w for w in st.windows if w.get("focus_timestamp")),
               key=lambda w: (w["focus_timestamp"]["secs"], w["focus_timestamp"]["nanos"]))]
    if st.focused:
        history = [i for i in history if i != st.focused["id"]] + [st.focused["id"]]
    own = {}
    col_of = own_widths(st, own)
    sigs = {}
    dirty = set()
    settle = set()
    removed = set()
    for ws in st.workspaces:
        sigs[ws] = st.signature(ws)
        cols, size, act = st.columns(ws), st.size(ws), st.workspaces[ws].get("active_window_id")
        a = next((k for k, c in enumerate(cols) if act in [x["id"] for x in c]), None)
        w = [c[0]["layout"]["tile_size"][0] for c in cols]
        if size and a is not None and all(v < size[0] - 0.5 for v in w):
            VIEW[ws] = {"ids": sigs[ws][1], "w": w, "a": a, "V": colx(w)[a] - target_x(w, a, size[0])}
        if relayout(st, ws):
            view_follow(State(), ws)
            dirty.add(ws)
    if st.focused_ws in dirty and place(st.focused_ws, history):
        dirty.discard(st.focused_ws)
    last_focus = st.focused and st.focused["id"]
    ws_focus = {ws: w.get("active_window_id") for ws, w in st.workspaces.items()}

    def col_widths(st):
        return tuple(c[0]["layout"]["tile_size"][0] for c in st.columns(st.focused_ws))

    wsw = (st.focused_ws, col_widths(st))
    replace_at = None

    def run_command(ev):
        nonlocal last_focus, wsw
        try:
            if ev["Command"] in ("full", "edges"):
                # started during the last key's animations, a narrowing column shows its edge
                # moving in while the view still slides the other way
                wait_sizes(dict(PENDING), 0.3)
                PENDING.clear()
                left = BUSY[0] - time.monotonic()
                if left > 0:
                    time.sleep(left)
                st = State()
                for ws in list(VIEW):
                    view_follow(st, ws)
                key_run(ev["Command"], history)
        except Exception:
            import traceback
            traceback.print_exc()   # a key that went wrong is not to stop the daemon
            VIEW.clear()
        finally:
            try:
                ev["conn"].sendall(b"ok\n")
                ev["conn"].close()
            except OSError:
                pass
        st = State()
        last_focus = st.focused and st.focused["id"]
        if st.focused_ws is not None and last_focus is not None:
            ws_focus[st.focused_ws] = last_focus
        wsw = (st.focused_ws, col_widths(st))

    while True:
        if held:
            run_command(held.pop(0))
            continue
        try:
            ev = q.get(timeout=None if replace_at is None else max(0, replace_at - time.monotonic()))
        except queue.Empty:
            # widths have settled (a new window finished opening, or a drag ended). Recompute
            # half_fit vs half_ovf, then place once. Place alone leaves the old 954 halves.
            replace_at = None
            st = State()
            for ws in list(VIEW):
                view_follow(st, ws)
            ws = st.focused_ws
            f = st.focused
            if ws is not None and f and not f["is_floating"] and f["workspace_id"] == ws:
                byid = {w["id"]: w for w in st.windows}
                extra = {}
                for w in st.windows:
                    if (w["id"] in known or w["is_floating"] or not w["layout"]["pos_in_scrolling_layout"]
                            or w["workspace_id"] != ws):
                        continue
                    known.add(w["id"])
                    prev = next((byid[i] for i in reversed(history) if i != w["id"] and i in byid
                                 and byid[i]["workspace_id"] == ws and not byid[i]["is_floating"]
                                 and byid[i]["layout"]["pos_in_scrolling_layout"]), None)
                    size = st.size(ws)
                    cls = classify(prev, *size) if prev and size else "half"
                    extra[w["id"]] = {"edges": "full", "other": prev and prev["layout"]["tile_size"][0]}.get(cls, cls)
                    own[w["id"]] = extra[w["id"]]
                if relayout(st, ws, extra or None):
                    view_follow(State(), ws)
                    st = State()
                sigs[ws] = st.signature(ws)
                place(ws, history)
                ws_focus[ws] = f["id"]
                st = State()
            wsw = (st.focused_ws, col_widths(st))
            continue
        if ev is None:
            sys.exit(0)
        if "Command" in ev:
            # Mod+F pressed again while one ran: two toggles are none
            burst, rest = [ev], []
            while True:
                try:
                    e = q.get_nowait()
                except queue.Empty:
                    break
                if e is None:
                    sys.exit(0)
                (burst if ev["Command"] == "full" and e.get("Command") == "full" else rest).append(e)
            for e in rest:
                q.put(e)
            for e in burst[:-1]:
                try:
                    e["conn"].sendall(b"ok\n")
                    e["conn"].close()
                except OSError:
                    pass
            if len(burst) % 2:
                run_command(burst[-1])
            else:
                try:
                    burst[-1]["conn"].sendall(b"ok\n")
                    burst[-1]["conn"].close()
                except OSError:
                    pass
            continue
        evs = [ev]
        # a focus change comes as a few events written at once: taken together without waiting
        # (niri already scrolls by itself; a correction 50 ms later shows as a second movement)
        quick = lambda e: all(k in QUICK_EVENTS for k in e)
        deadline = time.monotonic() + (0.004 if quick(ev) else 0.3)
        while time.monotonic() < deadline:
            if any(((e.get("WindowOpenedOrChanged") or {}).get("window") or {}).get("id") not in known | {None}
                   or "WindowClosed" in e for e in evs):
                break
            try:
                ev = q.get(timeout=0.002 if all(quick(e) for e in evs) else 0.05)
            except queue.Empty:
                break
            if ev is None:
                sys.exit(0)
            if "Command" in ev:
                held.append(ev)
                break
            evs.append(ev)
        for e in evs:
            fid = (e.get("WindowFocusChanged") or {}).get("id")
            w = (e.get("WindowOpenedOrChanged") or {}).get("window")
            if w and w.get("is_focused"):
                fid = w["id"]
            if fid is not None:
                if fid in history:
                    history.remove(fid)
                history.append(fid)

        st = State()
        for ws in list(VIEW):
            view_follow(st, ws)
        opened = False
        for e in evs:
            wid = ((e.get("WindowOpenedOrChanged") or {}).get("window") or {}).get("id")
            if wid is not None and wid not in known:
                opened = True
        ids = {w["id"] for w in st.windows}
        byid = {w["id"]: w for w in st.windows}
        acted = False
        new = {}
        for w in st.windows:
            if w["id"] in known or (not w["is_floating"] and not w["layout"]["pos_in_scrolling_layout"]):
                continue
            known.add(w["id"])
            if w["is_floating"]:
                continue
            ws = w["workspace_id"]
            prev = next((byid[i] for i in reversed(history) if i != w["id"] and i in byid
                         and byid[i]["workspace_id"] == ws and not byid[i]["is_floating"]
                         and byid[i]["layout"]["pos_in_scrolling_layout"] and i not in new), None)
            size = st.size(ws)
            cls = classify(prev, *size) if prev and size else "half"
            new[w["id"]] = {"edges": "full", "other": prev and prev["layout"]["tile_size"][0]}.get(cls, cls)
        history = [i for i in history if i in ids]
        known &= ids
        own = {i: c for i, c in own.items() if i in ids}
        split = {}
        for ws in st.workspaces:
            for c in st.columns(ws):
                i = c[0]["id"]
                if len(c) == 1 and i not in new and len(col_of.get(i, ())) > 1:
                    split[i] = own.get(i, "half")
        new.update(split)
        col_of = own_widths(st, own, skip=new)
        for i, cls in new.items():
            own[i] = cls
        changed = False
        for ws in st.workspaces:
            sig = st.signature(ws)
            if sig == sigs.get(ws) and not any(byid[i]["workspace_id"] == ws for i in new if i in byid):
                continue
            gone = {i for c in sigs.get(ws, (0, ()))[1] for i in c} - {i for c in sig[1] for i in c}
            if gone and last_focus not in gone:
                settle.add(ws)
            if gone:
                removed.add(ws)
            sigs[ws] = sig
            if relayout(st, ws, new):
                changed = True
                view_follow(State(), ws)
            dirty.add(ws)
        for ws in list(sigs):
            if ws not in st.workspaces:
                del sigs[ws]
                dirty.discard(ws)
                settle.discard(ws)
                removed.discard(ws)
        if st.focused_ws in dirty:
            dirty.discard(st.focused_ws)
            acted = place(st.focused_ws, history, settle=st.focused_ws in settle,
                          removed=st.focused_ws in removed)
            settle.discard(st.focused_ws)
            removed.discard(st.focused_ws)
        fid = st.focused and st.focused["id"]
        f = st.focused
        prev_ws_fid = ws_focus.get(st.focused_ws)
        if (not acted and fid != prev_ws_fid and f and not f["is_floating"]
                and f["workspace_id"] == st.focused_ws):
            p = byid.get(prev_ws_fid)
            d = 0
            if p and p["workspace_id"] == f["workspace_id"] and p["layout"]["pos_in_scrolling_layout"]:
                d = (f["layout"]["pos_in_scrolling_layout"][0] > p["layout"]["pos_in_scrolling_layout"][0]) - \
                    (f["layout"]["pos_in_scrolling_layout"][0] < p["layout"]["pos_in_scrolling_layout"][0])
            acted = place(st.focused_ws, history, d=d)
        if st.focused_ws is not None and f and not f["is_floating"] and f["workspace_id"] == st.focused_ws:
            ws_focus[st.focused_ws] = fid
        last_focus = fid
        if acted or changed:
            st = State()
        elif (wsw[0] == st.focused_ws and wsw[1] != col_widths(st) and f and not f["is_floating"]
                and f["workspace_id"] == st.focused_ws and not key_recent()):
            replace_at = time.monotonic() + 0.4
        # the open event often arrives before the column is in the layout. One settle pass
        # after the open animation copies the width class, switches fit halves to overflow, and places.
        if opened and not key_recent():
            replace_at = time.monotonic() + 0.4
        wsw = (st.focused_ws, col_widths(st))

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "daemon":
        daemon()
    elif cmd in ("full", "edges"):
        key(cmd)
    else:
        sys.exit("usage: niri-layout daemon|full|edges")
