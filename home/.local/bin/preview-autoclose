#!/usr/bin/env python3
import json, subprocess, sys, time

PREVIEW = "org.gnome.NautilusPreviewer"
GRACE = 0.4

wins = {}
opened = {}
focused = None

p = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
for line in p.stdout:
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    for kind, d in ev.items():
        if kind == "WindowsChanged":
            wins = {w["id"]: w["app_id"] for w in d["windows"]}
            f = [w["id"] for w in d["windows"] if w["is_focused"]]
            focused = f[0] if f else None
        elif kind == "WindowOpenedOrChanged":
            w = d["window"]
            if w["app_id"] == PREVIEW and w["id"] not in opened:
                opened[w["id"]] = time.monotonic()
            wins[w["id"]] = w["app_id"]
            if w["is_focused"]:
                focused = w["id"]
        elif kind == "WindowFocusChanged":
            prev, focused = focused, d["id"]
            if wins.get(prev) == PREVIEW and prev != focused and prev in opened \
                    and time.monotonic() - opened[prev] > GRACE:
                subprocess.run(["niri", "msg", "action", "close-window", "--id", str(prev)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif kind == "WindowClosed":
            wins.pop(d["id"], None)
            opened.pop(d["id"], None)
            if d["id"] == focused:
                focused = None
sys.exit(1)
