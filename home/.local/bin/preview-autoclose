#!/usr/bin/python3 -IS
"""Close the Nautilus previewer once it loses focus. Talks to $NIRI_SOCKET directly: no
`niri msg event-stream` child (17 MB RSS), no `niri msg` spawn per close (~9 ms)."""
import json, os, socket, sys, time

PREVIEW = "org.gnome.NautilusPreviewer"
GRACE = 0.4


def connect():
    s = socket.socket(socket.AF_UNIX)
    s.connect(os.environ["NIRI_SOCKET"])
    return s


def close_window(wid):
    with connect() as s:
        s.sendall(b'{"Action":{"CloseWindow":{"id":%d}}}\n' % wid)
        s.recv(256)


wins = {}
opened = {}
focused = None

events = connect()
events.sendall(b'"EventStream"\n')
for line in events.makefile("rb"):
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    for kind, d in ev.items():
        if kind == "WindowsChanged":
            wins = {w["id"]: w["app_id"] for w in d["windows"]}
            f = [w["id"] for w in d["windows"] if w["is_focused"]]
            focused = f[0] if f else None
        elif kind == "WindowOpenedOrChanged":
            w = d["window"]
            if w["app_id"] == PREVIEW and w["id"] not in opened:
                opened[w["id"]] = time.monotonic()
            wins[w["id"]] = w["app_id"]
            if w["is_focused"]:
                focused = w["id"]
        elif kind == "WindowFocusChanged":
            prev, focused = focused, d["id"]
            if wins.get(prev) == PREVIEW and prev != focused and prev in opened \
                    and time.monotonic() - opened[prev] > GRACE:
                try:
                    close_window(prev)
                except OSError:
                    pass
        elif kind == "WindowClosed":
            wins.pop(d["id"], None)
            opened.pop(d["id"], None)
            if d["id"] == focused:
                focused = None
sys.exit(1)
