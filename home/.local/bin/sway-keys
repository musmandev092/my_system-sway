#!/usr/bin/python3 -I
"""sway-keys [--write]: show every Sway shortcut (Fedora spin + DMS + your own) in the Switcher plugin's list.

Merges /etc/sway/config and the layered config.d files (later files win, like Sway) into
$XDG_RUNTIME_DIR/sway-keys.conf. --write only writes the file and prints its path; without it the
Switcher plugin shows the list (the plugin itself calls --write)."""
import glob, os, re, subprocess, sys

HOME = os.path.expanduser("~")
RUN = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
OUT = os.path.join(RUN, "sway-keys.conf")


def config_files():
    """Same order Sway loads them: the main config, then /etc/sway/config.d, then your config.d."""
    user = os.path.join(HOME, ".config/sway")
    main = os.path.join(user, "config")
    if not os.path.isfile(main):
        main = "/etc/sway/config"
    return ([main] + sorted(glob.glob("/etc/sway/config.d/*.conf"))
            + sorted(glob.glob(os.path.join(user, "config.d/*.conf"))))


def parse(files):
    sets, binds, order = [], {}, []
    for path in files:
        try:
            lines = open(path).read().splitlines()
        except OSError:
            continue
        stack = []  # "mode" or "binds:<flags>"
        for ln in lines:
            s = ln.strip()
            if not s or s.startswith("#"):
                continue
            if s == "}":
                if stack:
                    stack.pop()
                continue
            m = re.match(r"mode\s+.*\{$", s)
            if m:
                stack.append("mode")
                continue
            m = re.match(r"bindsym\s+((?:--\S+\s+)*)\{$", s)
            if m:
                stack.append("binds:" + m.group(1).strip())
                continue
            if "mode" in stack:
                continue
            if stack and stack[-1].startswith("binds:"):
                k = re.match(r"(\S+)\s+(.+)", s)
                if k:
                    flags = stack[-1][6:]
                    if k.group(1) not in binds:
                        order.append(k.group(1))
                    binds[k.group(1)] = (flags, k.group(2))
                continue
            if s.startswith("set "):
                sets.append(s)
                continue
            if s.startswith("unbindsym"):
                key = s.split()[-1]
                binds.pop(key, None)
                continue
            m = re.match(r"bindsym\s+((?:--\S+\s+)*)(\S+)\s+(.+)", s)
            if m:
                if m.group(2) not in binds:
                    order.append(m.group(2))
                binds[m.group(2)] = (m.group(1).strip(), m.group(3))
    return sets, binds, order


def main():
    sets, binds, order = parse(config_files())
    with open(OUT, "w") as f:
        f.write("# generated by sway-keys\n")
        for s in sets:
            f.write(s + "\n")
        for k in order:
            if k in binds:
                flags, cmd = binds[k]
                f.write(("bindsym %s %s %s\n" % (flags, k, cmd)).replace("  ", " "))
    if "--write" in sys.argv:
        print(OUT)
        return
    subprocess.run(["dms", "ipc", "call", "switcher", "open", "keys"])


main()
