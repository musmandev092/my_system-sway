{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "Fedora_small",
        "padding": {
            "top": 8,
            "right": 2
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "custom",
            "format": "{#green}Hardware"
        },
        {
            "type": "host",
            "key": "PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "GPU {index}",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "Display ({name})",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "Disk ({mountpoint})",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "Swap",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "Battery ({name})",
            "keyColor": "green"
        },
        {
            "type": "poweradapter",
            "key": "Power",
            "keyColor": "green"
        },
        {
            "type": "localip",
            "key": "Network ({ifname})",
            "keyColor": "green",
            "showIpv4": true,
            "showIpv6": false,
            "showLoop": false
        },
        "break",
        {
            "type": "custom",
            "format": "{#blue}Software"
        },
        {
            "type": "os",
            "key": "OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "key": "DE",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "Theme",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "Icons",
            "keyColor": "blue"
        },
        {
            "type": "font",
            "key": "Font",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "Cursor",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "Terminal Font",
            "keyColor": "blue"
        },
        {
            "type": "locale",
            "key": "Locale",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "custom",
            "format": "{#magenta}Age / Uptime / Update"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "OS Age",
            "keyColor": "magenta",
            "format": "{create-time:10} ({days} days)"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "Update",
            "keyColor": "magenta",
            "text": "dnf history list 2>/dev/null | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}' | sort -r | head -1"
        },
        "break",
        "colors"
    ]
}
